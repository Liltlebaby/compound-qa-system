{
  "name": "compound-qa-windows-server",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/start.mjs",
    "pretest": "npm run build:server",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run check:architecture && npm test && npm run build",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:import-sqlite": "node scripts/import-sqlite.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:setup": "node scripts/install-postgres.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.6.2",
    "rolldown": "1.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
